{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "paths": {
      "@msb/engine": ["./packages/engine/src/index.ts"],
      "@msb/hex": ["./packages/hex/src/index.ts"],
      "@msb/msb-rules": ["./packages/msb-rules/src/index.ts"],
      "@msb/msb-data": ["./packages/msb-data/src/index.ts"],
      "@msb/msb-ai": ["./packages/msb-ai/src/index.ts"],
      "@msb/sim": ["./packages/sim/src/index.ts"]
    }
  },
  "include": ["./packages/*/src", "packages/*/test", "vitest.config.ts"],
  "exclude": ["packages/client"]
}
