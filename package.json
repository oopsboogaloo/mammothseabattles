{
  "name": "mammoth-sea-battles",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run coverage",
    "mockup": "npm run dev -w @msb/client",
    "mockup:build": "npm run build -w @msb/client",
    "mockup:assets": "npm run assets -w @msb/client",
    "mockup:shoot": "npm run build -w @msb/client && node packages/client/scripts/shoot.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
